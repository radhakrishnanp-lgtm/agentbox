{
  "name": "@agentbox/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.mjs",
    "admin": "node --env-file-if-exists=../../.env src/cli.ts",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@agentbox/shared": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/session": "^11.1.3",
    "@fastify/static": "^10.1.0",
    "@simplewebauthn/server": "^14.0.0",
    "better-sqlite3": "^13.0.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.12.0",
    "fastify-type-provider-zod": "^7.0.0",
    "otpauth": "^9.5.0",
    "undici": "^7.30.0",
    "uuid": "^13.0.2",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@levischuck/tiny-cbor": "^0.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0"
  }
}
