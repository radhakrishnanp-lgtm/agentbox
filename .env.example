# agentbox server settings. The installer writes the real file to
# /etc/agentbox/agentbox.env (owner root, group agentbox, mode 0640).
# For local development copy this to .env and fill in the two secrets.

NODE_ENV=development

# Public address people type in. Must be https:// in production.
AGENTBOX_ORIGIN=http://localhost:5173
# Passkey scope. Defaults to the origin's hostname; only set it to change that.
# AGENTBOX_RP_ID=agent.example.com
AGENTBOX_RP_NAME=agentbox

# Where the SQLite database lives (created 0700).
AGENTBOX_DATA_DIR=./.data

# Production listens on a Unix socket only Caddy can reach.
# Development can use 127.0.0.1:<port> or localhost:<port>; nothing else is accepted.
AGENTBOX_LISTEN=127.0.0.1:8080

# Built web UI to serve. Leave unset in development (Vite serves it on :5173).
# AGENTBOX_WEB_DIST=/opt/agentbox/web

# 32 random bytes, base64. Encrypts secrets at rest (like the TOTP secret).
# Generate with: openssl rand -base64 32
AGENTBOX_ENCRYPTION_KEY=
# When rotating, move the old key here for one restart so data is re-encrypted.
# AGENTBOX_ENCRYPTION_KEY_PREVIOUS=

# At least 32 characters. Signs session cookies.
# Generate with: openssl rand -base64 48
AGENTBOX_SESSION_SECRET=

LOG_LEVEL=info
